# Copy to .env and fill in. Never commit real secrets.

# --- Shared ---
NODE_ENV=development

# --- API (apps/api) ---
PORT=3000

# Interim auth gate until Supabase Auth (M1). Required in production; when set,
# all /api routes except health/ingest/heartbeats/internal need X-Access-Token.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_TOKEN=

# Where the API serves the built dashboard from (defaults to apps/dashboard/dist).
DASHBOARD_DIST=

# Canonical hostname (no scheme). When set, page loads on any other host 301 to
# it, keeping the dashboard (and its stored access token) on a single origin.
CANONICAL_HOST=

# --- Redis / BullMQ (used from M2 onward) ---
REDIS_URL=redis://localhost:6379

# --- Supabase (AWM shared instance) — issued by Colin ---
# Used from M1 DB work onward. Service role key: backend only, never client-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Prisma (point at a DEV Supabase project, not shared prod) ---
# Setting this flips the API from the in-memory sample store to the live Prisma store.
DATABASE_URL=

# --- Secrets encryption (AES-256-GCM), 32-byte base64 key ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Workflow failure monitoring (docs/workflow-failure-monitoring.md) ---
# Ingest tokens: sample mode validates against these; live mode validates against
# workflow_sources.ingest_token_hash (sha256 of the token) in the DB.
INGEST_TOKEN_N8N=dev-ingest-n8n-sample-token
INGEST_TOKEN_ZAPIER=dev-ingest-zapier-sample-token

# n8n reconciliation sweep (apps/worker) — sweep stays idle until N8N_* + INGEST_TOKEN_N8N are set.
N8N_BASE_URL=
N8N_API_KEY=
API_BASE_URL=http://localhost:3000
SWEEP_INTERVAL_MS=300000

# --- Worker ↔ API shared secret (change for any non-local deployment) ---
WORKER_TOKEN=dev-worker-token-sample
POLL_INTERVAL_MS=10000
# Worker liveness endpoint (GET /health) for container/platform probes.
WORKER_PORT=3001

# --- Twilio (SMS / WhatsApp channels send for real when all three are set) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Dashboard dev proxy (apps/dashboard) ---
# Override when the API runs on a non-default port (e.g. http://localhost:3010).
AWM_API_TARGET=
